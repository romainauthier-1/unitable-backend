# Chaîne de connexion MongoDB (Atlas ou instance locale)
CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unitable

# Port d'écoute (défaut 3000, voir bin/www)
# PORT=3000

# Secret de signature des liens de réinitialisation de mot de passe et d'invitation
JWT_SECRET=

# URL du frontend desktop (utilisée dans les liens envoyés par e-mail)
URL_FRONTEND=http://localhost:3001

# Clé API SIRENE (INSEE) — récupération des infos d'un établissement par son SIRET
SIRENE_API_KEY=

# Brevo (envoi des e-mails transactionnels)
BREVO_API_KEY=
BREVO_SENDER_NAME=UniTable
BREVO_SENDER_EMAIL=
